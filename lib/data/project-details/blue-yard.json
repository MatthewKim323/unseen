 "blocksHtml": "<div class=\"container mb-5 mb-10@sm\">\n<div class=\"js-grid-slider mb-5 mb-10@sm overflow-hidden user-select-none\" data-cursor=\"drag\" data-cursor-progress=\"0\" style=\"touch-action: pan-y\">\n<div class=\"container\">\n<div class=\"d-flex items-center\" style=\"user-select: none;\">\n<div class=\"w-1/2 w-1/4@sm mr-5 mr-8@sm flex-no-shrink pointer-events-none\">\n<div class=\"mb-2\" style=\"perspective: 1000px;\">\n<div class=\"js-grid-slider-text\">\n<h2 animate-from=\"preset: 'fadeUp'\" class=\"mb-1 t-500 t-lh-1.1 t-uppercase t-ls-tight t-base\">Initial Exploration</h2>\n<p animate-from=\"preset: 'webglTextReveal'\" dom2webgl=\"c:TextReveal\">A selection of early work, exploring different visual representations of BlueYard’s core message – The Fabric of our Future.</p>\n</div>\n</div>\n</div>\n<div class=\"pointer-events-none js-slider-items\">\n<div class=\"d-flex mb-4\"><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(15%, -7%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"-50\" dom2webgl=\"image9518713\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/01-Home-page-v5.png\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(1%, -8%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"100\" dom2webgl=\"image9526010\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/02-Catagories-Nebula.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(5%, 8%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"-100\" dom2webgl=\"image9535163\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/02-Category-page-v5.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-12%, -5%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"200\" dom2webgl=\"image9552213\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/03-Catagories-Nebula.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(9%, -2%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"-100\" dom2webgl=\"image9611635\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/image-3.png\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-14%, 5%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"-100\" dom2webgl=\"image9587845\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/Homepage-Nebula.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-13%, -2%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"9\" dom2webgl=\"image9606351\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/image-2.png\"/></div></div><div class=\"d-flex\"><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(11%, 11%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"150\" dom2webgl=\"image95682\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/03-Category-page-v5.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(8%, 2%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"8\" dom2webgl=\"image962216\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/image-4.png\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(1%, 6%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"50\" dom2webgl=\"image954763\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/02-Category-page-v5.png\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-11%, 9%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"-50\" dom2webgl=\"image9644546\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/v3-scaled.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(14%, 4%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"100\" dom2webgl=\"image9579510\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/04-Category-page-v5.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(7%, 12%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"200\" dom2webgl=\"image9594322\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/image-1.png\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-9%, -2%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"50\" dom2webgl=\"image9632633\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/image-5.png\"/></div></div> </div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<img alt=\"\" animate-from=\"preset: 'webglParallaxEffect'\" class=\"d-block w-1/1\" crossorigin=\"\" decoding=\"async\" dom2webgl=\"image8576aaa71cc8236d\" src=\"https://unseen.co/wp-content/uploads/2021/11/large-full-screen-size-1920x1080.png\"/>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"grid flex-no-wrap@sm items-start\">\n<div class=\"w-1/1 w-10/12@sm\">\n<div class=\"w-1/1 w-10/12@sm mb-2 mb-0@sm\">\n<div class=\"t-1.3 t-2.25@sm t-300 t-lh-1.2 t-ls-tight\">\n<p animate-from=\"preset: 'webglTextReveal'\" class=\"mb-0\" dom2webgl=\"c:TextReveal\">\nOver 30,000 particles make up this bespoke nebula\n</p>\n</div>\n</div>\n</div>\n<div class=\"w-1/1 w-1/1@sm\">\n<div class=\"w-1/1 w-10/12@sm offset-2/12@sm mb-2 mb-0@sm\">\n<div class=\"\">\n<p animate-from=\"preset: 'webglTextReveal'\" class=\"mb-0\" dom2webgl=\"c:TextReveal\">\nThis site acts as an immersive portfolio experience that showcases the future-thinking ethos of BlueYard and the companies they invest in, along with positioning them as leaders in the space. On entering, users find themselves floating in the BlueYard galaxy, with clusters representing the different industries they invest in.<br/>\n<br/>\nAt the core of the experience is a bespoke nebula particle system that acts as the navigation to inner pages and establishes the core visual aesthetic. This futuristic look immediately sets the tone for what users can expect from the brand and ties in directly with BlueYard’s forward thinking approach.\n</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"https://unseen.co/wp-content/uploads/2021/11/intro-comppressed-3.mp4\" dom2webgl=\"image1018\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"https://unseen.co/wp-content/uploads/2021/11/galaxy.mp4\" dom2webgl=\"image1024\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"https://unseen.co/wp-content/uploads/2021/11/category_1.mp4\" dom2webgl=\"image1033\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n<div class=\"container d-flex@sm items-center justify-center mb-5 mb-20@sm\">\n<div class=\"w-1/1 w-1/3@sm mb-6 mb-0@sm relative\">\n<div class=\"aspect aspect--1/1 aspect--3/2@sm\">\n<div animate-from=\"y: function() { return store.mq.sm.matches ? '0%' : 0 }, rotationY: 30, rotationZ: 3, scrollTrigger: { scrub: 0.5, once: false }\" animate-to=\"y: function() { return store.mq.sm.matches ? '30%' : 0 }, rotationY: 10, rotationZ: -3\" class=\"aspect__child\" data-tex-type=\"image\" dom2webgl=\"c:PhoneModel\">\n<img alt=\"\" crossorigin=\"\" decoding=\"async\" src=\"https://unseen.co/wp-content/uploads/2021/11/Mob-1.png\"/>\n</div>\n</div>\n</div>\n<div class=\"w-1/1 w-1/3@sm relative\">\n<div class=\"aspect aspect--1/1 aspect--3/2@sm\">\n<div animate-from=\"y: function() { return store.mq.sm.matches ? '0%' : 0 }, rotationY: -30, rotationZ: -3, scrollTrigger: { scrub: 0.5, once: false }\" animate-to=\"y: function() { return store.mq.sm.matches ? '-10%' : 0 }, rotationY: -10, rotationZ: 3\" class=\"aspect__child\" data-tex-type=\"image\" dom2webgl=\"c:PhoneModel\">\n<img alt=\"\" crossorigin=\"\" decoding=\"async\" src=\"https://unseen.co/wp-content/uploads/2021/11/Mob-2.png\"/>\n</div>\n</div>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"grid flex-no-wrap@sm items-start\">\n<div class=\"w-1/1 w-10/12@sm\">\n<div class=\"w-1/1 w-10/12@sm mb-2 mb-0@sm\">\n<div class=\"t-1.3 t-2.25@sm t-300 t-lh-1.2 t-ls-tight\">\n<p animate-from=\"preset: 'webglTextReveal'\" class=\"mb-0\" dom2webgl=\"c:TextReveal\">\nA brand evolution for a revolutionary business\n</p>\n</div>\n</div>\n</div>\n<div class=\"w-1/1 w-1/1@sm\">\n<div class=\"w-1/1 w-10/12@sm offset-2/12@sm mb-2 mb-0@sm\">\n<div class=\"\">\n<p animate-from=\"preset: 'webglTextReveal'\" class=\"mb-0\" dom2webgl=\"c:TextReveal\">\nBuilding on the visuals that we created for the BlueYard web experience, we also designed a number of brand assets to be used across social media, pitch decks and other brand collateral. This allowed us to take the concepts and techniques that we explored during the creation of the website and develop them into high-fidelity 3D renders.\n</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"grid flex-no-wrap@sm\">\n<div class=\"w-1/1 w-1/1@sm\">\n<div class=\"mx-auto w-1/1\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"https://unseen.co/wp-content/uploads/2021/11/Looping-Brain-1_1.mp4\" dom2webgl=\"image1037\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n<div class=\"mx-auto w-1/1\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"https://unseen.co/wp-content/uploads/2021/11/2-3.mp4\" dom2webgl=\"image895\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n</div>\n<div class=\"mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<img alt=\"\" animate-from=\"preset: 'webglParallaxEffect'\" class=\"d-block w-1/1\" crossorigin=\"\" decoding=\"async\" dom2webgl=\"image10386aaa71cca934f\" src=\"https://unseen.co/wp-content/uploads/2021/11/large-scale-eng-1920x1358.png\"/>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"grid flex-no-wrap@sm items-start\">\n<div class=\"w-1/1 w-1/1@sm\">\n<div class=\"w-1/1 w-10/12@sm mb-2 mb-0@sm\">\n<div class=\"t-1.3 t-2.25@sm t-300 t-lh-1.2 t-ls-tight\">\n<p animate-from=\"preset: 'webglTextReveal'\" class=\"mb-0\" dom2webgl=\"c:TextReveal\">\nTechnical innovations\n</p>\n</div>\n</div>\n<div class=\"w-1/1 w-10/12@sm mb-2 mb-0@sm\">\n<div class=\"\">\n<p animate-from=\"preset: 'webglTextReveal'\" class=\"mb-0\" dom2webgl=\"c:TextReveal\">\nBuilding such a rich immersive experience did not come without technical challenges; complex particle animations and detailed embedded 3D models meant we had to come up with new and innovative techniques across both design and development phases to ensure the site runs performantly.<br/>\n<br/>\nA deep-rooted collaboration between 3D design and WebGL development allowed us to establish a custom workflow that enabled us to export complex particle based animations easily from Houdini as compressed image textures. On top of this, we also created a custom export format that could be imported into a WebGL environment resulting in 3D geometry with particle mapping and animation settings.<br/>\n</p>\n</div>\n</div>\n</div>\n<div class=\"w-1/1 w-1/1@sm\">\n<div class=\"mx-auto w-1/1\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"https://unseen.co/wp-content/uploads/2021/11/bts.mp4\" dom2webgl=\"image1049\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"grid flex-no-wrap@sm items-start\">\n<div class=\"w-1/1 w-1/1@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"https://unseen.co/wp-content/uploads/2021/11/bts-galaxy.mp4\" dom2webgl=\"image1061\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n<div class=\"w-1/1 w-1/1@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"https://unseen.co/wp-content/uploads/2021/11/Main-Galaxy-Animation-High-1.m4v\" dom2webgl=\"image1059\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n</div>\n</div>\n<div class=\"w-1/1 w-1/1@sm | js-awards\">\n<div class=\"container my-5 d-block d-flex@sm my-10@md overflow-hidden\">\n<div class=\"w-1/1 w-2/5@sm pr-0 pr-3@sm relative\">\n<h2 class=\"t-lh-1.1\">\n<span class=\"pl-0.25 t-serif t-italic t-500 t-2 t-3@sm\">Awards &amp; <br/></span>\n<span class=\"t-sans t-500 t-2 t-3@sm\">Recognition</span>\n</h2>\n<div class=\"award-trophy absolute fill w-1/1 h-1/1\" dom2webgl=\"c:Awards\"></div>\n</div>\n<div class=\"w-1/1 w-3/5@sm pt-1 pt-5@sm user-select-none\">\n<div class=\"award | js-award\" data-award-model=\"awwwards\">\n<div class=\"d-flex py-1 | js-award-inner\">\n<div class=\"w-1/2\">\n<h3 class=\"t-base t-uppercase mb-0\"><span class=\"award__arrow | js-award-arrow\"><span>⮡  </span></span>Awwwards</h3>\n</div>\n<div class=\"w-1/2\">\n<p class=\"t-small t-uppercase mb-0\">\nSite of the Day\n</p>\n</div>\n</div>\n</div>\n<div class=\"award | js-award\" data-award-model=\"fwa\">\n<div class=\"d-flex py-1 | js-award-inner\">\n<div class=\"w-1/2\">\n<h3 class=\"t-base t-uppercase mb-0\"><span class=\"award__arrow | js-award-arrow\"><span>⮡  </span></span>FWA</h3>\n</div>\n<div class=\"w-1/2\">\n<p class=\"t-small t-uppercase mb-0\">\nSite of the Day\n</p>\n</div>\n</div>\n</div>\n<div class=\"award | js-award\" data-award-model=\"css\">\n<div class=\"d-flex py-1 | js-award-inner\">\n<div class=\"w-1/2\">\n<h3 class=\"t-base t-uppercase mb-0\"><span class=\"award__arrow | js-award-arrow\"><span>⮡  </span></span>CSSDA</h3>\n</div>\n<div class=\"w-1/2\">\n<p class=\"t-small t-uppercase mb-0\">\nSite of the Day\n</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>",
