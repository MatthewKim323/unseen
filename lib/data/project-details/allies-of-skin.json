 "blocksHtml": "<div class=\"js-grid-slider mb-5 mb-10@sm overflow-hidden user-select-none\" data-cursor=\"drag\" data-cursor-progress=\"0\" style=\"touch-action: pan-y\">\n<div class=\"container\">\n<div class=\"d-flex items-center\" style=\"user-select: none;\">\n<div class=\"w-1/2 w-1/4@sm mr-5 mr-8@sm flex-no-shrink pointer-events-none\">\n<div class=\"mb-2\" style=\"perspective: 1000px;\">\n<div class=\"js-grid-slider-text\">\n<h2 animate-from=\"preset: 'fadeUp'\" class=\"mb-1 t-500 t-lh-1.1 t-uppercase t-ls-tight t-base\">R&amp;D</h2>\n<p animate-from=\"preset: 'webglTextReveal'\" dom2webgl=\"c:TextReveal\">A selection of imagery from the initial stages of the project. We created these conceptual treatments as conversation starters to then build upon as we progressed.<br/>\n</p>\n</div>\n</div>\n</div>\n<div class=\"pointer-events-none js-slider-items\">\n<div class=\"d-flex mb-4\"><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(14%, 3%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"100\" dom2webgl=\"image15046292\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/05/image-22.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(11%, 1%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"200\" dom2webgl=\"image15031265\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/05/image-21.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(11%, 7%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"120\" dom2webgl=\"image15066255\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/05/image-24.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-3%, -13%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"200\" dom2webgl=\"image15077939\" draggable=\"false\" src=\"https://unseen.c