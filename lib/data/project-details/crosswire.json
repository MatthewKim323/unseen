 "blocksHtml": "<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"https://unseen.co/wp-content/uploads/2023/02/Crosswire_Showcase_Compresssed21_220223_v01.mp4\" dom2webgl=\"image2447\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n<div class=\"js-grid-slider mb-5 mb-10@sm overflow-hidden user-select-none\" data-cursor=\"drag\" data-cursor-progress=\"0\" style=\"touch-action: pan-y\">\n<div class=\"container\">\n<div class=\"d-flex items-center\" style=\"user-select: none;\">\n<div class=\"w-1/2 w-1/4@sm mr-5 mr-8@sm flex-no-shrink pointer-events-none\">\n<div class=\"mb-2\" style=\"perspective: 1000px;\">\n<div class=\"js-grid-slider-text\">\n<h2 animate-from=\"preset: 'fadeUp'\" class=\"mb-1 t-500 t-lh-1.1 t-uppercase t-ls-tight t-base\">Concept Exploration</h2>\n<p animate-from=\"preset: 'webglTextReveal'\" dom2webgl=\"c:TextReveal\">Some early iterations of the core visual narrative and art direction.</p>\n</div>\n</div>\n</div>\n<div class=\"pointer-events-none js-slider-items\">\n<div class=\"d-flex mb-4\"><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(1%, 5%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"8\" dom2webgl=\"image25292743\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2023/05/Frame-409.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-2%, 4%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"100\" dom2webgl=\"image25346238\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2023/05/Frame-414.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(15%, 10%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"-8\" dom2webgl=\"image2531928\" draggable=\"false\" src=\"https://uns