 "blocksHtml": "<div class=\"js-grid-slider mb-5 mb-10@sm overflow-hidden user-select-none\" data-cursor=\"drag\" data-cursor-progress=\"0\" style=\"touch-action: pan-y\">\n<div class=\"container\">\n<div class=\"d-flex items-center\" style=\"user-select: none;\">\n<div class=\"w-1/2 w-1/4@sm mr-5 mr-8@sm flex-no-shrink pointer-events-none\">\n<div class=\"mb-2\" style=\"perspective: 1000px;\">\n<div class=\"js-grid-slider-text\">\n<h2 animate-from=\"preset: 'fadeUp'\" class=\"mb-1 t-500 t-lh-1.1 t-uppercase t-ls-tight t-base\">Concept Development</h2>\n<p animate-from=\"preset: 'webglTextReveal'\" dom2webgl=\"c:TextReveal\">A look at some of the work that went into creating this unique digital experience. </p>\n</div>\n</div>\n</div>\n<div class=\"pointer-events-none js-slider-items\">\n<div class=\"d-flex mb-4\"><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-4%, 3%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"100\" dom2webgl=\"image28618382\" draggable=\"false\" src=\"/media/f22eb3990898.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(2%, -8%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"-12\" dom2webgl=\"image2855793\" draggable=\"false\" src=\"/media/a928d934a9b6.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-4%, 4%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"-150\" dom2webgl=\"image28579640\" draggable=\"false\" src=\"/media/181a5556d60d.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-12%, 2%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"-100\" dom2webgl=\"image28595384\" draggable=\"false\" src=\"/media/52a6f8e7d944.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(2%, -7%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"