d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"-50\" dom2webgl=\"image24634118\" draggable=\"false\" src=\"/media/f412556cc822.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(0%, -2%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"75\" dom2webgl=\"image24714937\" draggable=\"false\" src=\"/media/4ec806edbb20.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-14%, 5%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"3\" dom2webgl=\"image247480\" draggable=\"false\" src=\"/media/baf885bd51be.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(1%, -1%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"50\" dom2webgl=\"image24769322\" draggable=\"false\" src=\"/media/08174201188a.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-7%, 3%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"15\" dom2webgl=\"image24781693\" draggable=\"false\" src=\"/media/799e60317f8b.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(0%, -6%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"50\" dom2webgl=\"image24809443\" draggable=\"false\" src=\"/media/f9ebfee76c1d.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(14%, 4%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"-10\" dom2webgl=\"image24826359\" draggable=\"false\" src=\"/media/933606f868a5.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(6%, 1%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"50\" dom2webgl=\"image24844229\" draggable=\"false\" src=\"/media/f98145b7c390.jpg\"/></div></div> </div>\n</div>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"/media/caa9aed303ee.mp4\" dom2webgl=\"image2485\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"grid flex-no-wrap@sm items-start\">\n<div class=\"w-1/1 w-1/1@sm mb-2 mb-0@sm\">\n<div class=\"t-1.3 t-2.25@sm t-300 t-lh-1.2 t-ls-tight\">\n<p animate-from=\"preset: 'webglTextReveal'\" class=\"mb-0\" dom2webgl=\"c:TextReveal\">\nShowcasing Quai’s Key Features\n</p>\n</div>\n</div>\n<div class=\"w-1/1 w-1/1@sm mb-2 mb-0@sm\">\n<div class=\"\">\n<p animate-from=\"preset: 'webglTextReveal'\" class=\"mb-0\" dom2webgl=\"c:TextReveal\">\nOur objective was to develop an immersive platform that could effectively showcase the revolutionary features of Quai Network. To achieve this, we conceptualised the idea of a virtual building, which acts as the core visual narrative device. Leveraging the power of WebGL, we brought this vision to life through the creation of an interactive 3D environment. The digital world we built provides a unique experience for users, enabling them to navigate through the various features of Quai Network and gain a deeper understanding of what sets it apart from their competition.\n</p>\n</div>\n</div>\n</div>\n</div>\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<img alt=\"\" animate-from=\"preset: 'webglParallaxEffect'\" class=\"d-block w-1/1\" crossorigin=\"\" decoding=\"async\" dom2webgl=\"image24866aaa76c214860\" src=\"/media/2da39ffcaa2a.jpg\"/>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<img alt=\"\" animate-from=\"preset: 'webglPeelEffect'\" class=\"d-block w-1/1\" crossorigin=\"\" decoding=\"async\" dom2webgl=\"image24896aaa76c226543\" src=\"/media/f44e221ca124.jpg\"/>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"grid flex-no-wrap@sm items-start\">\n<div class=\"w-1/1 w-1/1@sm mb-2 mb-0@sm\">\n<div class=\"t-1.3 t-2.25@sm t-300 t-lh-1.2 t-ls-tight\">\n<p animate-from=\"preset: 'webglTextReveal'\" class=\"mb-0\" dom2webgl=\"c:TextReveal\">\nImmersive Scrolling Journey \n</p>\n</div>\n</div>\n<div class=\"w-1/1 w-1/1@sm mb-2 mb-0@sm\">\n<div class=\"\">\n<p animate-from=\"preset: 'webglTextReveal'\" class=\"mb-0\" dom2webgl=\"c:TextReveal\">\nQuia’s draws inspiration from science fiction and the mesmerising light installations of artist James Turrell. We used the visual metaphor of a city being constructed to symbolise the reconstruction of digital currency. The use of scroll-triggered interactions adds a tactile feel to the site and offers users the freedom to experience it at their own pace. This allows for a more immersive experience, as users can navigate through the site in a way that feels natural to them. \n</p>\n</div>\n</div>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"/media/62a4b338a45a.mp4\" dom2webgl=\"image2492\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<img alt=\"\" animate-from=\"preset: 'webglPeelEffect'\" class=\"d-block w-1/1\" crossorigin=\"\" decoding=\"async\" dom2webgl=\"image25036aaa76c23875f\" src=\"/media/0d787d7ddedc.jpg\"/>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<img alt=\"\" animate-from=\"preset: 'webglPeelEffect'\" class=\"d-block w-1/1\" crossorigin=\"\" decoding=\"async\" dom2webgl=\"image25046aaa76c24acb6\" src=\"/media/6d6322e7ace7.jpg\"/>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorig