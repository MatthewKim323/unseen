 "blocksHtml": "<div class=\"js-grid-slider mb-5 mb-10@sm overflow-hidden user-select-none\" data-cursor=\"drag\" data-cursor-progress=\"0\" style=\"touch-action: pan-y\">\n<div class=\"container\">\n<div class=\"d-flex items-center\" style=\"user-select: none;\">\n<div class=\"w-1/2 w-1/4@sm mr-5 mr-8@sm flex-no-shrink pointer-events-none\">\n<div class=\"mb-2\" style=\"perspective: 1000px;\">\n<div class=\"js-grid-slider-text\">\n<h2 animate-from=\"preset: 'fadeUp'\" class=\"mb-1 t-500 t-lh-1.1 t-uppercase t-ls-tight t-base\">Initial Exploration</h2>\n<p animate-from=\"preset: 'webglTextReveal'\" dom2webgl=\"c:TextReveal\">A selection of early work, exploring different visual representations of Dala’s core brand mission – organising fragmented knowledge.</p>\n</div>\n</div>\n</div>\n<div class=\"pointer-events-none js-slider-items\">\n<div class=\"d-flex mb-4\"><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-12%, -14%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"100\" dom2webgl=\"image12248657\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/1-1.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(12%, -2%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"4\" dom2webgl=\"image12271969\" draggable=\"false\" src=\"/media/b3932ee6e559.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(9%, 7%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"-200\" dom2webgl=\"image12366135\" draggable=\"false\" src=\"/media/913dc9a8ca70.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-9%, 9%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"-100\" dom2webgl=\"image12359944\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/8.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(4%, -11%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"200\" dom2webgl=\"image12384997\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/9.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(5%, -3%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"200\" dom2webgl=\"image19882038\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/3D-Tile-Mock-Up.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-14%, 15%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"-3\" dom2webgl=\"image19942194\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/materials_test_3.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(14%, 10%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"-200\" dom2webgl=\"image19982927\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/materials_test_4.jpg\"/></div></div><div class=\"d-flex\"><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(2%, -5%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"-100\" dom2webgl=\"image12284561\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/3.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-10%, -2%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"50\" dom2webgl=\"image12328056\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/5.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-14%, -14%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"100\" dom2webgl=\"image12331704\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/6.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-10%, -7%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"50\" dom2webgl=\"image12343988\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/7.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(9%, 9%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"12\" dom2webgl=\"image12397695\" draggable=\"false\" src=\"/media/2a6a025842d9.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-10%, 9%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"300\" dom2webgl=\"image19963128\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/Frame-143.jpg\"/></div><div class=\"w-1/3 flex-no-shrink mr-4\" style=\"transform: translate(-9%, -11%)\"><img alt=\"\" class=\"d-block w-1/1 js-slider-item\" crossorigin=\"\" data-z=\"100\" dom2webgl=\"image19923793\" draggable=\"false\" src=\"https://unseen.co/wp-content/uploads/2021/11/materials_test_2.jpg\"/></div></div> </div>\n</div>\n</div>\n</div>\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<img alt=\"\" animate-from=\"preset: 'webglParallaxEffect'\" class=\"d-block w-1/1\" crossorigin=\"\" decoding=\"async\" dom2webgl=\"image11416aaa710c84e6b\" src=\"https://unseen.co/wp-content/uploads/2021/11/Frame-3.jpg\"/>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"grid flex-no-wrap@sm items-start\">\n<div class=\"w-1/1 w-1/1@sm mb-2 mb-0@sm\">\n<div class=\"t-1.3 t-2.25@sm t-300 t-lh-1.2 t-ls-tight\">\n<p animate-from=\"preset: 'webglTextReveal'\" class=\"mb-0\" dom2webgl=\"c:TextReveal\">\nCreating a brand with meaning\n</p>\n</div>\n</div>\n<div class=\"w-1/1 w-1/1@sm mb-2 mb-0@sm\">\n<div class=\"\">\n<p animate-from=\"preset: 'webglTextReveal'\" class=\"mb-0\" dom2webgl=\"c:TextReveal\">\nDala’s exists to unify fragmented workplace knowledge with its cutting-edge search AI, turning your business files into a hive mind. When creating the brand, we drew inspiration from this central idea, and the mark acts as a visual metaphor for this core theme. We used fragmented shapes drawn together to form a stylised ‘D’ and when rotated, the shape resembles a brain. This theme was then extended through Dala’s visual language and communication, resulting in a meaningful and cohesive brand identity.\n</p>\n</div>\n</div>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"grid flex-no-wrap@sm items-start\">\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"https://unseen.co/wp-content/uploads/2021/11/Comp-1_6.mp4\" dom2webgl=\"image1262\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"https://unseen.co/wp-content/uploads/2021/11/brand_tile_animation_compressed26.mp4\" dom2webgl=\"image1260\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<img alt=\"\" animate-from=\"preset: 'webglPeelEffect'\" class=\"d-block w-1/1\" crossorigin=\"\" decoding=\"async\" dom2webgl=\"image11626aaa710c8ac08\" src=\"https://unseen.co/wp-content/uploads/2021/11/brand_tile_test.jpg\"/>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<img alt=\"\" animate-from=\"preset: 'webglPeelEffect'\" class=\"d-block w-1/1\" crossorigin=\"\" decoding=\"async\" dom2webgl=\"image11656aaa710c901f2\" src=\"https://unseen.co/wp-content/uploads/2021/11/brand_tile_2_test.jpg\"/>\n</div>\n</div>\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<img alt=\"\" animate-from=\"preset: 'webglParallaxEffect'\" class=\"d-block w-1/1\" crossorigin=\"\" decoding=\"async\" dom2webgl=\"image24536aaa710c9bc67\" src=\"https://unseen.co/wp-content/uploads/2021/11/Dala_BrandGuideDisplay_Compressed_230223_v01.jpg\"/>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<img alt=\"\" animate-from=\"preset: 'webglPeelEffect'\" class=\"d-block w-1/1\" crossorigin=\"\" decoding=\"async\" dom2webgl=\"image11676aaa710ca0b63\" src=\"https://unseen.co/wp-content/uploads/2021/11/billboard_1_test.jpg\"/>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"https://unseen.co/wp-content/uploads/2021/11/Cards-Full-1.mp4\" dom2webgl=\"image1476\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<img alt=\"\" animate-from=\"preset: 'webglParallaxEffect'\" class=\"d-block w-1/1\" crossorigin=\"\" decoding=\"async\" dom2webgl=\"image12406aaa710ca1b2a\" src=\"https://unseen.co/wp-content/uploads/2021/11/dock_test_3_compressed-1920x884.jpg\"/>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"grid flex-no-wrap@sm items-center\">\n<div class=\"w-1/1 w-1/1@sm\">\n<div class=\"w-1/1 w-8/12@sm mb-2 mb-0@sm mb-1@sm\">\n<div class=\"t-1.3 t-2.25@sm t-300 t-lh-1.2 t-ls-tight\">\n<p animate-from=\"preset: 'webglTextReveal'\" class=\"mb-0\" dom2webgl=\"c:TextReveal\">\nFinding the perfect visual representation for Dala’s cutting edge service\n</p>\n</div>\n</div>\n<div class=\"w-1/1 w-8/12@sm mb-2 mb-0@sm\">\n<div class=\"\">\n<p animate-from=\"preset: 'webglTextReveal'\" class=\"mb-0\" dom2webgl=\"c:TextReveal\">\nThe ideation phase of a project is a time to experiment both visually and conceptually in order to find that unique idea. When it came to creating Dala’s online experience, we focused on the core theme of ‘fragmented knowledge’ while also experimenting with art direction and interaction design.\n</p>\n</div>\n</div>\n</div>\n<div class=\"w-1/1 w-1/1@sm\">\n<div class=\"mx-auto w-1/1\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"https://unseen.co/wp-content/uploads/2021/11/Dala_wip_1000_compressed28.mp4\" dom2webgl=\"image1193\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n</div>\n</div>\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<img alt=\"\" animate-from=\"preset: 'webglParallaxEffect'\" class=\"d-block w-1/1\" crossorigin=\"\" decoding=\"async\" dom2webgl=\"image20556aaa710cab2ba\" src=\"https://unseen.co/wp-content/uploads/2021/11/Display-Web-Grid.jpg\"/>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"grid flex-no-wrap@sm items-start\">\n<div class=\"w-1/1 w-1/1@sm mb-2 mb-0@sm\">\n<div class=\"t-1.3 t-2.25@sm t-300 t-lh-1.2 t-ls-tight\">\n<p animate-from=\"preset: 'webglTextReveal'\" class=\"mb-0\" dom2webgl=\"c:TextReveal\">\nPiecing together the story\n</p>\n</div>\n</div>\n<div class=\"w-1/1 w-1/1@sm mb-2 mb-0@sm\">\n<div class=\"\">\n<p animate-from=\"preset: 'webglTextReveal'\" class=\"mb-0\" dom2webgl=\"c:TextReveal\">\nWe created a WebGL particle system for Dala which sits at the epicentre of the website. We use these fragments as a perpetual storytelling device, morphing them to form different visual metaphors as the user navigates down the page.\n</p>\n<div class=\"mt-2\">\n<a class=\"btn btn--regular btn--fill btn--light js-btn\" data-btn=\"fill\" data-cursor=\"hide\" href=\"http://dala.craftedbygc.com\" target=\"_blank\" title=\"\">\n<span class=\"btn__inner js-btn-inner\">\n<span class=\"btn__content js-btn-content\">\n<span class=\"d-flex flex-row items-end\">\n<span class=\"btn__text\">\nLive website\n</span>\n<svg class=\"btn__icon d-inline-block js-btn-icon\">\n<use xlink:href=\"/assets/images/img-687f48138f.svg#arrow\"></use>\n</svg>\n</span>\n</span>\n</span>\n</a>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"https://unseen.co/wp-content/uploads/2021/11/dala_part_1_compressed26.mp4\" dom2webgl=\"image1125\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"https://unseen.co/wp-content/uploads/2021/11/dala_part_2_compressed26.mp4\" dom2webgl=\"image1127\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n<div class=\"container mb-5 mb-10@sm\">\n<div class=\"mx-auto w-1/1 mb-5 mb-10@md\">\n<video animate-from=\"preset: 'webglPeelEffect'\" autoplay=\"\" class=\"d-block w-1/1\" crossorigin=\"\" data-src=\"https://unseen.co/wp-content/uploads/2021/11/dala_part_3_compressed26.mp4\" dom2webgl=\"image1134\" loop=\"\" muted=\"\" playsinline=\"\"></video>\n</div>\n</div>\n<div class=\"container d-flex@sm items-center justify-center mb-5 mb-20@sm\">\n<div class=\"w-1/1 w-1/3@sm mb-6 mb-0@sm relative\">\n<div class=\"aspect aspect--1/1 aspect--3/2@sm\">\n<div animate-from=\"y: function() { return store.mq.sm.matches ? '0%' : 0 }, rotationY: 30, rotationZ: 3, scrollTrigger: { scrub: 0.5, once: false }\" animate-to=\"y: function() { return store.mq.sm.matches ? '30%' : 0 }, rotationY: 10, rotationZ: -3\" class=\"aspect__child\" data-tex-type=\"image\" dom2webgl=\"c:PhoneModel\">\n<img alt=\"\" crossorigin=\"\" decoding=\"async\" src=\"https://unseen.co/wp-content/uploads/2021/11/mobile_1_compressed-1.jpg\"/>\n</div>\n</div>\n</div>\n<div class=\"w-1/1 w-1/3@sm relative\">\n<div class=\"aspect aspect--1/1 aspect--3/2@sm\">\n<div animate-from=\"y: function() { return store.mq.sm.matches